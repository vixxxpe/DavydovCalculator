<Application x:Class="DavydovCalculator.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#1C1C24" />
        <SolidColorBrush x:Key="DisplayForeground" Color="#F5F5F7" />
        <SolidColorBrush x:Key="SecondaryForeground" Color="#8E8E9A" />

        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="Background" Value="#2E2E3A" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FunctionButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#4A4A5A" />
            <Setter Property="FontSize" Value="22" />
        </Style>

        <Style x:Key="OperatorButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#FF9F0A" />
            <Setter Property="FontSize" Value="26" />
        </Style>

        <Style x:Key="EqualsButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#30D158" />
            <Setter Property="FontSize" Value="28" />
        </Style>
    </Application.Resources>
</Application>
