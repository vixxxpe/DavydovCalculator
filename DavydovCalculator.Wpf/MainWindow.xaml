<Window x:Class="DavydovCalculator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DavydovCalculator.Wpf"
        Title="Калькулятор — Давыдов С. П."
        Width="380" Height="640"
        MinWidth="320" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="8,8,8,16">
            <Viewbox Height="36" StretchDirection="DownOnly" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Expression}"
                           Foreground="{StaticResource SecondaryForeground}"
                           FontSize="26" />
            </Viewbox>
            <Viewbox Height="64" StretchDirection="DownOnly" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Result}"
                           Foreground="{StaticResource DisplayForeground}"
                           FontSize="48"
                           FontWeight="Light" />
            </Viewbox>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="C" Style="{StaticResource FunctionButton}"
                    Command="{Binding ClearCommand}" />
            <Button Grid.Row="0" Grid.Column="1" Content="(" Style="{StaticResource FunctionButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="(" />
            <Button Grid.Row="0" Grid.Column="2" Content=")" Style="{StaticResource FunctionButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter=")" />
            <Button Grid.Row="0" Grid.Column="3" Content="⌫" Style="{StaticResource FunctionButton}"
                    Command="{Binding BackspaceCommand}" />

            <Button Grid.Row="1" Grid.Column="0" Content="7" Style="{StaticResource CalcButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="7" />
            <Button Grid.Row="1" Grid.Column="1" Content="8" Style="{StaticResource CalcButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="8" />
            <Button Grid.Row="1" Grid.Column="2" Content="9" Style="{StaticResource CalcButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="9" />
            <Button Grid.Row="1" Grid.Column="3" Content="/" Style="{StaticResource OperatorButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="/" />

            <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource CalcButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="4" />
            <Button Grid.Row="2" Grid.Column="1" Content="5" Style="{StaticResource CalcButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="5" />
            <Button Grid.Row="2" Grid.Column="2" Content="6" Style="{StaticResource CalcButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="6" />
            <Button Grid.Row="2" Grid.Column="3" Content="*" Style="{StaticResource OperatorButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="*" />

            <Button Grid.Row="3" Grid.Column="0" Content="1" Style="{StaticResource CalcButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="1" />
            <Button Grid.Row="3" Grid.Column="1" Content="2" Style="{StaticResource CalcButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="2" />
            <Button Grid.Row="3" Grid.Column="2" Content="3" Style="{StaticResource CalcButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="3" />
            <Button Grid.Row="3" Grid.Column="3" Content="-" Style="{StaticResource OperatorButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="-" />

            <Button Grid.Row="4" Grid.Column="0" Content="0" Style="{StaticResource CalcButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="0" />
            <Button Grid.Row="4" Grid.Column="1" Content="," Style="{StaticResource CalcButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="," />
            <Button Grid.Row="4" Grid.Column="2" Content="^" Style="{StaticResource OperatorButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="^" />
            <Button Grid.Row="4" Grid.Column="3" Content="+" Style="{StaticResource OperatorButton}"
                    Command="{Binding AddSymbolCommand}" CommandParameter="+" />

            <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Content="=" Style="{StaticResource EqualsButton}"
                    Command="{Binding CalculateCommand}" />
        </Grid>
    </Grid>
</Window>
